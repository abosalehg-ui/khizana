    <string name="backup_saved">Backup saved.</string>
    <string name="backup_failed">Backup failed.</string>
    <string name="restore_done">Restore complete. Run a scan to re-attach files.</string>
    <string name="restore_failed">Restore failed — is this a Khizana backup file?</string>
    <string name="restore_confirm_title">Restore over current data?</string>
    <string name="restore_confirm_message">For every book the backup knows about, its reading position, shelf and hidden flag replace what you have now — so restoring an older backup rewinds your reading progress. Shelves and tags the backup doesn’t mention are left alone.</string>
